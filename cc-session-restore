<script>
let n = null, rows = [], checked = new Set(), known = new Set(), busy = false, active = null;
const $ = id => document.getElementById(id);
// Per-run secret every /api call must send back. The server embeds it only in the
// first (one-time link) load; keep it in sessionStorage, which is per-tab and
// per-origin (so per-port), for reloads of this tab.
const TOKEN = (() => {
  const t = document.querySelector('meta[name="ccsr-token"]').content;
  try {
    if (t) sessionStorage.setItem("ccsr-token", t);
    return t || sessionStorage.getItem("ccsr-token") || "";
  } catch (e) { return t; }
})();

function el(tag, cls, text) { const e = document.createElement(tag); if (cls) e.className = cls; if (text != null) e.textContent = text; return e; }
const plural = (k, word) => `${k} ${word}${k === 1 ? "" : "s"}`;
const rowEls = () => [...$("list").children];
const shown = () => rowEls().filter(r => !r.hidden);
const rowFor = id => rowEls().find(r => r.dataset.id === id);
const isRow = t => !!(t && t.classList && t.classList.contains("row"));
const session = r => rows.find(s => s.id === r.dataset.id);

// Roving focus: exactly one visible row is in the tab order.
function setActive(r, focus) {
  rowEls().forEach(x => { x.tabIndex = -1; });
  active = r ? r.dataset.id : null;
  if (!r) return;
  r.tabIndex = 0;
  if (focus) { r.focus(); r.scrollIntoView({ block: "nearest" }); }
}

function toggle(r) {
  const s = session(r);
  if (!s || s.running) return;
  checked.has(s.id) ? checked.delete(s.id) : checked.add(s.id);
  r.setAttribute("aria-selected", String(checked.has(s.id)));
  update();
}

function build() {
  $("list").replaceChildren(...rows.map(s => {
    const r = el("div", "row" + (s.running ? " running" : ""));
    r.dataset.id = s.id;
    r.setAttribute("role", "option");
    r.setAttribute("aria-selected", String(checked.has(s.id)));
    if (s.running) r.setAttribute("aria-disabled", "true");
    const box = el("span", "box"); box.setAttribute("aria-hidden", "true");
    const info = el("div", "info");
    info.append(el("div", "title", s.title), el("div", "folder", s.folder));
    const meta = el("div", "meta");
    if (s.running) meta.append(el("span", "pill", "running"));
    meta.append(el("span", "ago", s.ago));
    r.append(box, info, meta);
    return r;
  }));
  applyFilter();
}

// Hiding a row never unticks it; the Open button and the status line count hidden ticks.
function applyFilter() {
  const q = $("filter").value.trim().toLowerCase();
  rowEls().forEach(r => {
    const s = session(r);
    r.hidden = !!q && !(s.title + "\n" + s.folder).toLowerCase().includes(q);
  });
  const vis = shown();
  vis.forEach((r, i) => r.classList.toggle("first", i === 0));
  $("list").hidden = !vis.length;
  const cur = active && rowFor(active);
  setActive(cur && !cur.hidden ? cur : vis[0] || null, false);
  $("empty").textContent = !rows.length ? "No Claude Code sessions found." :
                           !vis.length ? "No sessions match the filter." : "";
  update();
}

function update() {
  const k = checked.size;
  const visible = new Set(shown().map(r => r.dataset.id));
  const hidden = [...checked].filter(id => !visible.has(id)).length;
  $("open").disabled = !k || busy;
  $("open").textContent = !k ? "Open" : `Open ${plural(k, "session")}` + (hidden ? ` (${hidden} hidden)` : "");
  const filtered = !!$("filter").value.trim();
  // All and None act on the rows the filter shows, so say so while it hides some.
  $("all").textContent = filtered ? "Tick shown" : "All";
  $("none").textContent = filtered ? "Untick shown" : "None";
  $("status").textContent = (filtered ? `${visible.size} of ${rows.length} shown. ` : "") +
    `${k} ticked` + (hidden ? `, ${hidden} hidden by the filter.` : ".");
}

function clearFilter() { $("filter").value = ""; applyFilter(); }

function stopped() {
  $("alert").textContent = "The picker has stopped (it closes after 15 idle minutes). Run it again.";
  $("open").disabled = true;
}

async function load() {
  let data;
  try {
    const res = await fetch("/api/sessions" + (n ? `?n=${n}` : ""), { headers: { "X-CCSR-Token": TOKEN } });
    if (!res.ok) throw new Error(res.status);
    data = await res.json();
  } catch (e) { return stopped(); }
  const hadFocus = isRow(document.activeElement);
  n = data.count;
  rows = data.sessions;
  // Keep your own ticks; only pre-check sessions we haven't shown before.
  rows.forEach(s => { if (!known.has(s.id)) { known.add(s.id); if (s.checked) checked.add(s.id); } });
  const live = rows.filter(s => s.running).length;
  $("sub").textContent = "Ticked sessions were open when your machine went down." +
    (live === 1 ? " 1 is already running, so it can't be opened again." :
     live ? ` ${live} are already running, so they can't be opened again.` : "");
  build();
  if (hadFocus && active) setActive(rowFor(active), true);
}

async function openIds(ids) {
  if (!ids.length || busy) return;
  busy = true; $("open").disabled = true;
  let data;
  try {
    const res = await fetch("/api/open", { method: "POST", headers: { "Content-Type": "application/json", "X-CCSR-Token": TOKEN },
                                           body: JSON.stringify({ ids }) });
    data = await res.json();
