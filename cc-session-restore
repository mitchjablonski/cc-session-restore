#!/usr/bin/env python3
__doc__ = """cc-session-restore - reopen your Claude Code sessions after a restart.

Unofficial; not affiliated with Anthropic. Works on macOS, Linux, Windows and WSL.

  cc-session-restore              interactive picker in the terminal
  cc-session-restore --gui        the same, as a page in your browser
                                  (--no-browser just prints the URL; --port N picks the port)
  cc-session-restore list         just print the list
  cc-session-restore doctor       print a diagnostic report for bug reports
                                  (--verbose includes private paths, titles and field names)
  cc-session-restore -y           reopen the pre-checked sessions without asking
  cc-session-restore -n 30        show 30 sessions instead of 15
  cc-session-restore --dry-run    print the launch commands instead of running them
  cc-session-restore --terminal T open sessions with terminal T (see below)
  cc-session-restore --install    add a "Claude Code sessions" launcher (Start menu / app menu)
  cc-session-restore --json       machine-readable list
  cc-session-restore --open ID... open these sessions by id

Terminals: wsl (Windows Terminal from WSL), windows-terminal, windows-console,
tmux, iterm, macos-terminal, gnome-terminal, konsole, xfce4-terminal, kitty,
wezterm, alacritty, x-terminal-emulator, xterm. Picked automatically; override
with --terminal or CC_SESSION_RESTORE_TERMINAL.

Environment:
  CC_SESSION_RESTORE_TERMINAL     terminal to use (as above)
  CC_SESSION_RESTORE_CLAUDE_ARGS  extra flags for every resumed session, e.g. "--model opus"
  CC_SESSION_RESTORE_CLAUDE_BIN   command to run instead of `claude`
  CLAUDE_CONFIG_DIR               Claude Code's config folder (default ~/.claude)

How it knows what you had open:
  - Every session's transcript (<config>/projects/*/<id>.jsonl) is written on
    every message, so its file time is when you last used that session.
  - Claude Code keeps <config>/sessions/<pid>.json while a session runs and
    removes it on a clean exit. A file whose process started before the
    machine's last boot means "this was open when the machine went down".
  - Sessions still running are listed as "running" and can't be opened again.
"""
import json
import os
import platform
import re
import shlex
import shutil
import subprocess
import sys
import tempfile
import time
from collections import Counter
from pathlib import Path

__version__ = "0.1.1"

CLAUDE = Path(os.environ.get("CLAUDE_CONFIG_DIR") or Path.home() / ".claude")
PROJECTS = CLAUDE / "projects"
REGISTRY = CLAUDE / "sessions"
DEFAULT_COUNT = 15
SCAN_LIMIT = 1000           # newest transcripts to look at
CHUNK = 64 * 1024           # transcripts are read in chunks...
HEAD_MAX = 4 * 1024 * 1024  # ...until the first line with a cwd, up to this much
TAIL_BYTES = 1024 * 1024    # end of the transcript, for the latest title
PRECHECK_DAYS = 7           # pre-check leftovers within this long of the newest one
MAX_AGE_DAYS = 14           # ...and only if last seen within this long before boot
CLAUDE_ARGS = os.environ.get("CC_SESSION_RESTORE_CLAUDE_ARGS", "")
CLAUDE_BIN = os.environ.get("CC_SESSION_RESTORE_CLAUDE_BIN", "claude")
WINDOW_NAME = "claude"      # Windows Terminal window that sessions open in
LINUX_TERMINALS = ("gnome-terminal", "konsole", "xfce4-terminal", "kitty", "wezterm",
                   "alacritty", "x-terminal-emulator", "xterm")
SUPPORTED_TERMINALS = frozenset(LINUX_TERMINALS) | {
    "wsl", "windows-terminal", "windows-console", "tmux", "iterm", "macos-terminal",
}

IS_WINDOWS = os.name == "nt"
IS_MAC = sys.platform == "darwin"
IS_WSL = bool(os.environ.get("WSL_DISTRO_NAME"))
SESSION_ID = re.compile(r"^[0-9A-Za-z][0-9A-Za-z_-]{0,127}$")
TEMP_DIRS = {os.path.normcase(p) for p in
             (str(Path(tempfile.gettempdir()).resolve()), "/tmp", "/private/tmp", "/var/folders")}


def die(msg):
    sys.exit(f"cc-session-restore: {msg}")


def num(v):
    return v if isinstance(v, (int, float)) and not isinstance(v, bool) else 0


def clean_title(t):
    """Titles can come from model-generated text: keep them printable and short."""
    if not isinstance(t, str):
        return ""
    t = re.sub(r"[\x00-\x1f\x7f]+", " ", t)
    return " ".join(t.split())[:80]


# ---------------------------------------------------------------- liveness

_boot = []


def boot_info():
    """Unix time of the last boot (or None) and the platform source queried."""
    if not _boot:
        bt = None
        try:
            if IS_WINDOWS:
                source = "Windows GetTickCount64"
                import ctypes
                ctypes.windll.kernel32.GetTickCount64.restype = ctypes.c_ulonglong
                bt = time.time() - ctypes.windll.kernel32.GetTickCount64() / 1000
            elif IS_MAC:
                source = "sysctl kern.boottime"
                out = subprocess.run(["sysctl", "-n", "kern.boottime"], capture_output=True,
                                     text=True, timeout=5).stdout
                m = re.search(r"sec = (\d+)", out)
                bt = int(m.group(1)) if m else None
            else:
                source = "procfs btime"
                for line in Path("/proc/stat").read_text().splitlines():
                    if line.startswith("btime "):
                        bt = int(line.split()[1])
        except Exception:
            bt = None
        _boot.append((bt, source))
    return _boot[0]


def boot_time():
    return boot_info()[0]


def _alive_windows(pid):
    import ctypes
    k32 = ctypes.windll.kernel32
    h = k32.OpenProcess(0x1000, False, pid)  # PROCESS_QUERY_LIMITED_INFORMATION
    if not h:
        return False
    code = ctypes.c_ulong()
    ok = k32.GetExitCodeProcess(h, ctypes.byref(code))
    k32.CloseHandle(h)
    return bool(ok) and code.value == 259  # STILL_ACTIVE


def is_alive(d):
    """True if a registry entry's process is still running."""
    pid = d.get("pid")
    if not isinstance(pid, int) or isinstance(pid, bool) or pid <= 0:
        return False
    # Started before the last boot -> dead, whatever holds that pid now.
    started, bt = num(d.get("startedAt")) / 1000, boot_time()
    if started and bt and started < bt - 60:
        return False
    if IS_WINDOWS:
        return _alive_windows(pid)
    stat = Path(f"/proc/{pid}/stat")
    if stat.exists() or sys.platform.startswith("linux"):
        try:
            fields = stat.read_text().rsplit(")", 1)[1].split()
        except (OSError, IndexError):
            return False
        proc_start = d.get("procStart")  # same pid but a different process -> dead
        return proc_start is None or str(proc_start) == fields[19]
    try:
        os.kill(pid, 0)
    except ProcessLookupError:
        return False
    except PermissionError:
        return True
    except OSError:
        return False
    return True


# ---------------------------------------------------------------- discovery

# Core fields used to identify a process and decide whether its session can be restored.
EXPECTED_REGISTRY_FIELDS = {"sessionId", "pid", "startedAt", "entrypoint", "kind"}
KNOWN_REGISTRY_FIELDS = EXPECTED_REGISTRY_FIELDS | {
    "procStart", "updatedAt", "statusUpdatedAt", "name", "nameSource",
}


def _load_json(f):
    for attempt in range(2):  # Claude may be rewriting the file right now
        try:
            d = json.loads(f.read_text(encoding="utf-8"))
            return d if isinstance(d, dict) else None
        except (OSError, ValueError, UnicodeDecodeError):
            if attempt == 0:
                time.sleep(0.05)
    return None


def directory_entries(path, report, label=None):
    """Record directory listing failures that a glob would silently skip."""
    try:
        entries = list(path.iterdir())
        status = "found"
    except (FileNotFoundError, NotADirectoryError):
        status, entries = "not found", []
    except OSError as error:
        status, entries = "unreadable", []
        report.errors.append((path, error))
    if label:
        report.directories[label] = status
    elif status == "unreadable":
        report.unreadable_project_folders += 1
    return entries


def discovery_files(root, pattern, report, label, nested=False):
    if report is None:
        # Keep the picker's established glob behavior, including dangling links.
        yield from root.glob("*/" + pattern if nested else pattern)
        return
    entries = directory_entries(root, report, label)
    if nested:
        entries = (path for child in entries for path in directory_entries(child, report))
    yield from (path for path in entries if path.match(pattern))


def read_registry(report=None):
    """-> running ids, {dead id: last seen}, {id: user-given name}, {id: derived name}"""
    running, dead, user_names, other_names, newest = set(), {}, {}, {}, {}
    for f in discovery_files(REGISTRY, "*.json", report, "Registry"):
        d = _load_json(f)
        if d is None:
            if report:
                report.registry["unparseable"] += 1
            continue
        sid = d.get("sessionId")
        valid_id = isinstance(sid, str) and SESSION_ID.fullmatch(sid)
        if not valid_id and not report:
            continue
        alive = is_alive(d)
        if report:
            report.registry["parsed"] += 1
            report.registry["running" if alive else "dead"] += 1
            report.missing.update(EXPECTED_REGISTRY_FIELDS - d.keys())
            report.unknown.update(d.keys() - KNOWN_REGISTRY_FIELDS)
        if not valid_id:
            report.registry["invalid IDs"] += 1
            if not alive:
                report.registry["dead invalid"] += 1
            continue
        try:
            mtime = f.stat().st_mtime
        except OSError:
            mtime = 0
        seen = max(num(d.get("updatedAt")) / 1000, num(d.get("statusUpdatedAt")) / 1000, mtime)
        if alive:
            running.add(sid)
        elif d.get("entrypoint") == "cli" and d.get("kind") == "interactive":
            dead[sid] = max(dead.get(sid, 0), seen)
        elif report:
            report.registry["dead non-interactive"] += 1
        name = clean_title(d.get("name"))
        if name and seen >= newest.get(sid, -1):
            newest[sid] = seen
            (user_names if d.get("nameSource") == "user" else other_names)[sid] = name
    for sid in running:
        dead.pop(sid, None)
    if report:
        report.registry["dead session IDs"] = len(dead)
    return running, dead, user_names, other_names


def _scan(data, info):
    for line in data.splitlines():
        if b'"cwd"' not in line and b'-title"' not in line:
            continue
        try:
            d = json.loads(line)
        except ValueError:
            continue  # includes cut-off first/last lines
        if not isinstance(d, dict):
            continue
        if "cwd" not in info and isinstance(d.get("cwd"), str):
            info["cwd"] = d["cwd"]
            info["entrypoint"] = d.get("entrypoint")
        if d.get("type") == "custom-title" and clean_title(d.get("customTitle")):
            info["title"] = clean_title(d.get("customTitle"))  # later lines win
        elif d.get("type") == "ai-title" and clean_title(d.get("aiTitle")):
            info["aiTitle"] = clean_title(d.get("aiTitle"))


def read_transcript(path):
    """cwd and entrypoint from the start of a transcript; latest titles from start and end."""
    info = {}
    try:
        with open(path, "rb") as fh:
            head, buf = 0, b""
            while "cwd" not in info and head < HEAD_MAX:
                chunk = fh.read(CHUNK)
                if not chunk:
                    break
                head += len(chunk)
                buf += chunk
                lines = buf.split(b"\n")
                buf = lines.pop()  # keep the unfinished line for the next chunk
                _scan(b"\n".join(lines), info)
            size = os.fstat(fh.fileno()).st_size
            if "cwd" in info and size > head:
                fh.seek(max(head, size - TAIL_BYTES))
                _scan(fh.read(), info)
    except OSError:
        if not info.get("cwd"):
            info["unreadable"] = True
    return info


def in_temp_dir(cwd):
    c = os.path.normcase(cwd)
    return any(c == t or c.startswith((t + "/", t + os.sep)) for t in TEMP_DIRS)


def recent_sessions(report=None):
    running, dead, user_names, other_names = read_registry(report)
    files = []
    for p in discovery_files(PROJECTS, "*.jsonl", report, "Projects", nested=True):
        try:
            files.append((p.stat().st_mtime, p))
        except OSError:
            if report:
                report.skip(p, "unreadable")
    files.sort(reverse=True)
    if report:
        report.over_limit = max(0, len(files) - SCAN_LIMIT)

    sessions = []
    for mtime, p in files[:SCAN_LIMIT]:
        sid = p.stem
        if not SESSION_ID.fullmatch(sid):
            if report:
                report.skip(p, "invalid session ID")
            continue
        info = read_transcript(p)
        cwd = info.get("cwd")
        # Only sessions you ran yourself in a terminal, in folders that still exist.
        reason = transcript_skip_reason(info)
        if reason:
            if report:
                report.skip(p, reason, cwd)
            continue
        title = (user_names.get(sid) or info.get("title") or info.get("aiTitle")
                 or other_names.get(sid) or clean_title(Path(cwd).name) or sid[:8])
        # A leftover registry file only counts if nothing used the session after it:
        # a later clean run (which removes its own file) means it wasn't open at the end.
        last_seen = dead.get(sid)
        was_open = last_seen is not None and mtime <= last_seen + 3600
        sessions.append({"id": sid, "cwd": cwd, "title": title, "mtime": mtime,
                         "was_open": was_open, "seen": max(last_seen or 0, mtime),
                         "running": sid in running})
    return sessions


def transcript_skip_reason(info):
    cwd = info.get("cwd")
    if info.get("unreadable"):
        return "unreadable"
    if not cwd:
        return "no cwd"
    if info.get("entrypoint") != "cli":
        return "SDK/background"
    if in_temp_dir(cwd):
        return "temporary folder"
    try:
        if not Path(cwd).is_dir():
            return "missing folder"
    except (OSError, ValueError):
        return "unreadable"
    return None


class DoctorReport:
    def __init__(self, verbose):
        self.directories = {}
        self.unreadable_project_folders = 0
        self.errors = []
        self.registry = Counter()
        self.missing = Counter()
        self.unknown = Counter()
        self.skipped = Counter()
        self.over_limit = 0
        self.skipped_paths = [] if verbose else None

    def skip(self, path, reason, cwd=None):
        self.skipped[reason] += 1
        if self.skipped_paths is not None:
            self.skipped_paths.append((reason, path, cwd))


def diagnostic_text(value):
    """Keep private details on one line, even for unusual filenames or field names."""
    return "".join(c if c.isprintable() else "?" for c in str(value))


def doctor(verbose=False):
    report = DoctorReport(verbose)
    bt, source = boot_info()
    boot = time.strftime("%Y-%m-%d %H:%M:%S UTC", time.gmtime(bt)) if bt is not None else "unknown"
    terminal = detect_terminal(required=False)
    # The override is arbitrary user input and could itself contain a private path.
    if os.environ.get("CC_SESSION_RESTORE_TERMINAL") and terminal not in SUPPORTED_TERMINALS:
        terminal = diagnostic_text(terminal) if verbose else "unrecognized override"
    print(f"cc-session-restore version: {__version__}")
    print(f"OS: {platform.system()}{' (WSL)' if IS_WSL else ''}")
    print(f"Python: {platform.python_version()}")
    print(f"Terminal: {terminal or 'none detected'}")
    config_source = "CLAUDE_CONFIG_DIR" if os.environ.get("CLAUDE_CONFIG_DIR") else "default"
    directory_entries(CLAUDE, report, "Config")
    print(f"Config directory: {report.directories['Config']} ({config_source})")
    print(f"Boot time: {boot} ({source})")
    sessions = recent_sessions(report)
    for label in ("Registry", "Projects"):
        print(f"{label} directory: {report.directories[label]}")
    print(f"Unreadable project folders: {report.unreadable_project_folders}")
    registry = report.registry
    print(f"Registry files: {registry['parsed']} parsed, {registry['unparseable']} unparseable, "
          f"{registry['running']} running, {registry['dead']} dead")
    print(f"Invalid registry session IDs: {registry['invalid IDs']}")
    print(f"Dead CLI/interactive session IDs: {registry['dead session IDs']}")
    redundant = (registry["dead"] - registry["dead invalid"] - registry["dead non-interactive"]
                 - registry["dead session IDs"])
    print(f"  Dead files excluded: {registry['dead invalid']} invalid ID, "
          f"{registry['dead non-interactive']} non-interactive or non-CLI, "
          f"{redundant} duplicate or also running")
    print("Missing registry fields (files):" + ("" if report.missing else " none"))
    for key, count in sorted(report.missing.items()):
        print(f"  {key}: {count}")
    print(f"Unknown registry fields: {len(report.unknown)} distinct")
    skipped = sum(report.skipped.values())
    print(f"Transcripts: {len(sessions) + skipped} scanned, {len(sessions)} included, {skipped} skipped")
    for reason in ("no cwd", "SDK/background", "missing folder", "unreadable", "temporary folder",
                   "invalid session ID"):
        print(f"  {reason}: {report.skipped[reason]}")
    if report.over_limit:
        print(f"Outside scan limit: {report.over_limit}")
    if verbose:
        print(f"Config path: {diagnostic_text(CLAUDE)}")
        for path, error in report.errors:
            print(f"Unreadable: {diagnostic_text(path)} | {diagnostic_text(error)}")
        for key, count in sorted(report.unknown.items()):
            print(f"Unknown registry field: {diagnostic_text(key)} ({count} files)")
        for s in sessions:
            print(f"Included: {diagnostic_text(s['title'])} | {diagnostic_text(s['cwd'])}")
        for reason, path, cwd in report.skipped_paths:
            folder = f" | {diagnostic_text(cwd)}" if cwd else ""
            print(f"Skipped ({reason}): {diagnostic_text(path)}{folder}")


def precheck(sessions):
    """Ids of sessions that were most likely open when the machine went down."""
    cands = [s for s in sessions if s["was_open"] and not s["running"]]
    if not cands:
        return set()
    cutoff = max(s["seen"] for s in cands) - PRECHECK_DAYS * 86400
    bt = boot_time()
    if bt:
        cutoff = max(cutoff, bt - MAX_AGE_DAYS * 86400)
    return {s["id"] for s in cands if s["seen"] >= cutoff}


def limit(sessions, count, keep):
    """Running and pre-checked sessions, plus the `count` most recent others."""
    out, others = [], 0
    for s in sessions:
        if s["running"] or s["id"] in keep:
            out.append(s)
        elif others < count:
            out.append(s)
            others += 1
    return out


def ago(ts):
    s = time.time() - ts
    for unit, n in (("d", 86400), ("h", 3600), ("m", 60)):
        if s >= n:
            return f"{int(s // n)}{unit} ago"
    return "just now"


def pretty_path(cwd):
    cwd = re.sub(r"^/mnt/c/Users/[^/]+/", "C:~/", cwd)  # WSL view of the Windows profile
    home = str(Path.home())
    if os.path.normcase(cwd) == os.path.normcase(home) or \
            os.path.normcase(cwd).startswith(os.path.normcase(home) + os.sep):
        cwd = "~" + cwd[len(home):]
    return cwd


# ---------------------------------------------------------------- launching

def detect_terminal(required=True):
    t = os.environ.get("CC_SESSION_RESTORE_TERMINAL")
    if t:
        return t
    if IS_WSL and shutil.which("wt.exe"):
        return "wsl"
    if IS_WINDOWS:
        return "windows-terminal" if shutil.which("wt.exe") else "windows-console"
    if os.environ.get("TMUX"):
        return "tmux"
    if IS_MAC:
        if os.environ.get("TERM_PROGRAM") == "iTerm.app":
            return "iterm"
        if os.environ.get("TERM_PROGRAM") == "Apple_Terminal":
            return "macos-terminal"
        return "iterm" if Path("/Applications/iTerm.app").exists() else "macos-terminal"
    # Linux: the terminal we're running in, if we can tell, else the first one installed.
    if os.environ.get("WEZTERM_PANE"):
        return "wezterm"
    if os.environ.get("KITTY_WINDOW_ID"):
        return "kitty"
    if os.environ.get("KONSOLE_VERSION"):
        return "konsole"
    if os.environ.get("GNOME_TERMINAL_SCREEN") or os.environ.get("GNOME_TERMINAL_SERVICE"):
        return "gnome-terminal"
    for t in LINUX_TERMINALS:
        if shutil.which(t):
            return t
    if required:
        die("couldn't find a terminal to open sessions in. Set CC_SESSION_RESTORE_TERMINAL.")
    return None


def login_shell():
    """Your login shell, run as a login+interactive shell so `claude` is on PATH
    the same way it is when you open a terminal yourself."""
    shell = None
    try:
        import pwd
        shell = pwd.getpwuid(os.getuid()).pw_shell
    except Exception:
        pass
    shell = shell or os.environ.get("SHELL") or "/bin/bash"
    if Path(shell).name in ("csh", "tcsh"):  # can't combine -l with -c
        shell = "/bin/bash" if Path("/bin/bash").exists() else "/bin/sh"
    return [shell, "-l", "-i", "-c"]


def claude_cmd(s):
    return f"{shlex.quote(CLAUDE_BIN)} --resume {shlex.quote(s['id'])} {CLAUDE_ARGS}".strip()


def applescript_str(text):
    return '"' + text.replace("\\", "\\\\").replace('"', '\\"') + '"'


def konsole_quote(text):
    """Shell "..." quoting that writes every $ as \\$, which Konsole doesn't expand."""
    return '"' + re.sub(r'([\\"$`])', r"\\\1", text) + '"'


def wt(args):
    """Windows Terminal treats ';' as a command separator even inside arguments."""
    return [a.replace(";", "\\;") for a in args]


def launch_cmd(s, terminal):
    """-> (argv, popen kwargs) that open session s in a new tab/window."""
    cwd, title, inner = s["cwd"], s["title"], claude_cmd(s)
    win_cmd = ["cmd", "/k", CLAUDE_BIN, "--resume", s["id"],
               *shlex.split(CLAUDE_ARGS, posix=not IS_WINDOWS)]

    if terminal == "wsl":
        distro = os.environ.get("WSL_DISTRO_NAME") or die("--terminal wsl only works inside WSL")
        # -e runs the shell directly, so `inner` is interpreted once, by your shell.
        return ["wt.exe", *wt(["-w", WINDOW_NAME, "new-tab", "--title", title, "wsl.exe",
                               "-d", distro, "--cd", cwd, "-e", *login_shell(), inner])], {}
    if terminal == "windows-terminal":
        return ["wt.exe", *wt(["-w", WINDOW_NAME, "new-tab", "--title", title, "-d", cwd,
                               *win_cmd])], {}
    if terminal == "windows-console":
        # No std handle redirection, or the new console gets no keyboard/screen.
        return win_cmd, {"cwd": cwd, "creationflags": 0x10, "console": True}  # CREATE_NEW_CONSOLE

    sh = [*login_shell(), inner]
    if terminal == "tmux":
        return ["tmux", "new-window", "-n", title, "-c", cwd, shlex.join(sh)], {}
    cd_and_run = applescript_str("cd " + shlex.quote(cwd) + " && " + inner)
    if terminal == "macos-terminal":
        script = ('set wasRunning to application "Terminal" is running\n'
                  'tell application "Terminal"\nactivate\n'
                  f'if wasRunning then\ndo script {cd_and_run}\n'
                  f'else\ndelay 0.5\ndo script {cd_and_run} in window 1\nend if\nend tell')
        return ["osascript", "-e", script], {}
    if terminal == "iterm":
        script = ('set wasRunning to application "iTerm2" is running\n'
                  'tell application "iTerm2"\nactivate\n'
                  'if not wasRunning then delay 1\n'
                  'if (count of windows) = 0 then\ncreate window with default profile\n'
                  'else if wasRunning then\ntell current window to create tab with default profile\nend if\n'
                  f'tell current session of current window to write text {cd_and_run}\nend tell')
        return ["osascript", "-e", script], {}
    linux = {
        # --opt=value, so a title starting with "-" isn't taken for an option.
        "gnome-terminal": ["gnome-terminal", "--tab", f"--title={title}", f"--working-directory={cwd}", "--", *sh],
        # Konsole expands $VARS in --workdir and -e arguments, so also cd in the shell, and
        # quote every word with konsole_quote (CLAUDE_ARGS as plain words, as on Windows).
        "konsole": ["konsole", "--new-tab", "--workdir", cwd, "-e", *login_shell(),
                    f"cd {konsole_quote(cwd)} && " + " ".join(map(konsole_quote, win_cmd[2:]))],
        "xfce4-terminal": ["xfce4-terminal", "--tab", f"--title={title}", f"--working-directory={cwd}", "-x", *sh],
        "kitty": ["kitty", f"--directory={cwd}", f"--title={title}", *sh],
        "wezterm": (["wezterm", "cli", "spawn", "--cwd", cwd, "--", *sh] if os.environ.get("WEZTERM_PANE")
                    else ["wezterm", "start", "--cwd", cwd, "--", *sh]),
        "alacritty": ["alacritty", f"--working-directory={cwd}", f"--title={title}", "-e", *sh],
        "x-terminal-emulator": ["x-terminal-emulator", "-T", title, "-e", *sh],  # Debian Policy 11.8.3
        "xterm": ["xterm", "-T", title, "-e", *sh],
    }
    if terminal in linux:
        return linux[terminal], {"cwd": cwd}
    die(f"unknown terminal '{terminal}'. Run with --help to see the options.")


def launch(sessions, dry_run=False, terminal=None, log=print):
    """Open each session. Returns a list of error messages (empty if all went well)."""
    terminal = terminal or detect_terminal()
    errors = []
    for s in sessions:
        argv, kw = launch_cmd(s, terminal)
        if dry_run:
            log(" ".join(shlex.quote(c) for c in argv))
            continue
        if not shutil.which(argv[0]):
            die(f"'{argv[0]}' not found (terminal: {terminal}). Set CC_SESSION_RESTORE_TERMINAL.")
        log(f"  opening {s['title']}")
        console = kw.pop("console", False)
        # stderr goes to a temp file, not a pipe: terminals like xterm keep running
        # and would block once a pipe nobody reads fills up.
        err_file = None if console else tempfile.TemporaryFile()
        streams = {} if console else {"stdin": subprocess.DEVNULL, "stdout": subprocess.DEVNULL,
                                       "stderr": err_file}
        try:
            p = subprocess.Popen(argv, **streams, **kw)
        except OSError as e:
            errors.append(f"{s['title']}: {e}")
            continue
        # Windows Terminal drops tabs that arrive too fast; others just keep order.
        time.sleep(0.8 if terminal in ("wsl", "windows-terminal") else 0.3)
        # Launchers like tmux/osascript exit quickly; report it if one failed.
        if not console:
            if p.poll() not in (None, 0):
                err_file.seek(0)
                err = err_file.read().decode("utf-8", "replace").strip().splitlines()
                errors.append(f"{s['title']}: {argv[0]} failed" + (f" ({err[-1]})" if err else ""))
            err_file.close()
    return errors


# ---------------------------------------------------------------- text UI

def show(sessions, selected):
    for i, s in enumerate(sessions, 1):
        mark = "running" if s["running"] else ("[x]" if s["id"] in selected else "[ ]")
        print(f"  {mark:>7} {i:2}  {s['title'][:28]:<28}  {ago(s['mtime']):>9}  {pretty_path(s['cwd'])}")


def pick(sessions, selected):
    while True:
        show(sessions, selected)
        try:
            ans = input("\nEnter = open checked | numbers (e.g. 2 5) = toggle | a = all | n = none | q = quit: ").strip().lower()
        except EOFError:
            return []
        print()
        if ans == "":
            return [s for s in sessions if s["id"] in selected]
        if ans == "q":
            return []
        if ans == "a":
            selected = {s["id"] for s in sessions if not s["running"]}
        elif ans == "n":
            selected = set()
        else:
            for tok in ans.replace(",", " ").split():
                if tok.isdecimal() and 1 <= int(tok) <= len(sessions) and not sessions[int(tok) - 1]["running"]:
                    selected ^= {sessions[int(tok) - 1]["id"]}


