  $("bar").remove();
  document.removeEventListener("keydown", onKey);  // the list and filter are gone
  const app = $("app"); app.replaceChildren();
  const d = el("div", "done");
  const errs = data.errors || [];
  const h = el("h1", null, data.error ? "Something went wrong" : `Opened ${plural(data.opened, "session")}`);
  h.tabIndex = -1;
  const msg = el("div"); msg.setAttribute("role", data.error || errs.length ? "alert" : "status");
  if (data.error) msg.append(el("p", "sub err", data.error));
  if (errs.length) { const ul = el("ul", "err"); errs.forEach(x => ul.append(el("li", null, x))); msg.append(ul); }
  if (!data.error && !errs.length) { msg.append(el("p", "sub", "You can close this tab.")); setTimeout(() => window.close(), 1500); }
  d.append(h, msg);
  app.append(d);
  h.focus();
}

$("open").addEventListener("click", () => openIds([...checked]));
$("all").addEventListener("click", () => {
  shown().forEach(r => { const s = session(r); if (!s.running) checked.add(s.id); });
  build();
});
$("none").addEventListener("click", () => { shown().forEach(r => checked.delete(r.dataset.id)); build(); });
$("more").addEventListener("click", () => { n += 25; load(); });
$("filter").addEventListener("input", applyFilter);
$("list").addEventListener("click", e => {
  const r = e.target.closest(".row");
  if (r) { setActive(r, true); toggle(r); }
});
$("list").addEventListener("dblclick", e => {
  const r = e.target.closest(".row");
  if (r && !session(r).running) openIds([r.dataset.id]);
});

function onKey(e) {
  const t = e.target, inFilter = t === $("filter"), onRow = isRow(t);
  if (e.key === "Escape" && $("filter").value) { e.preventDefault(); clearFilter(); return; }
  if (e.key === "/" && !inFilter && !e.ctrlKey && !e.metaKey && !e.altKey) {
    e.preventDefault(); $("filter").focus(); $("filter").select(); return;
  }
  const nav = ["ArrowDown", "ArrowUp", "Home", "End"].includes(e.key);
  if (nav && (onRow || t === document.body || (inFilter && e.key === "ArrowDown"))) {
    const vis = shown();
    if (!vis.length) return;
    e.preventDefault();
    const i = onRow ? vis.indexOf(t) : -1;
    const j = e.key === "Home" ? 0 : e.key === "End" ? vis.length - 1 :
              e.key === "ArrowDown" ? Math.min(i + 1, vis.length - 1) : (i < 0 ? 0 : Math.max(i - 1, 0));
    setActive(vis[j], true);
    return;
  }
  if (e.key === " " && onRow) { e.preventDefault(); toggle(t); return; }
  // Enter opens only from the page itself or a row, never from a button or the filter box.
  if (e.key !== "Enter" || e.repeat) return;
  if (t === document.body || onRow) { e.preventDefault(); openIds([...checked]); }
}
document.addEventListener("keydown", onKey);
load();
</script>
