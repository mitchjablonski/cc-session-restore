def sessions_payload(count):
    all_sessions = recent_sessions()
    keep = precheck(all_sessions)
    sessions = limit(all_sessions, count, keep)
    return {"count": count, "running": sum(s["running"] for s in sessions), "sessions": [
        {"id": s["id"], "title": s["title"], "cwd": s["cwd"], "ago": ago(s["mtime"]),
         "folder": pretty_path(s["cwd"]), "checked": s["id"] in keep, "running": s["running"]}
        for s in sessions]}


def open_in_browser(url):
    import webbrowser
    if IS_WSL and shutil.which("cmd.exe"):  # use the Windows browser
        subprocess.Popen(["cmd.exe", "/c", "start", "", url], stdout=subprocess.DEVNULL,
                         stderr=subprocess.DEVNULL, cwd="/mnt/c" if Path("/mnt/c").is_dir() else None)
    else:
        webbrowser.open(url)


def run_gui(count, terminal, browser=True, port=0, idle_timeout=900):
    """Serve the picker page on localhost until you open sessions or leave it idle."""
    import secrets
    import threading
    from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
    from urllib.parse import parse_qs, urlparse

    # The URL carries a one-time token (it may be visible in the browser's command
    # line); the first page load swaps it for a cookie that the API then requires.
    # Cookies aren't isolated by port, so a server on another local port that the
    # browser visits receives that cookie and could replay it. So the API also needs a
    # second secret in an X-CCSR-Token header. It is embedded only in the response to
    # the one-time link (the page keeps it in per-origin sessionStorage for reloads);
    # loading the page with just the cookie serves it without the secret.
    url_token, cookie, api_token = (secrets.token_urlsafe(18), secrets.token_urlsafe(24),
                                    secrets.token_urlsafe(24))
    first_page = PAGE.replace("__CCSR_TOKEN__", api_token)
    later_page = PAGE.replace("__CCSR_TOKEN__", "")

    def same(a, b):
        # compare_digest raises on non-ASCII str; compare bytes so odd input is just "no".
        return secrets.compare_digest(a.encode("utf-8", "surrogateescape"),
                                      b.encode("utf-8", "surrogateescape"))
    state = {"done": False, "opening": False, "url_used": False, "last": time.time()}
    lock = threading.Lock()

    class Handler(BaseHTTPRequestHandler):
        def log_message(self, *args):
            pass

        def send(self, code, body, ctype="application/json", headers=()):
            data = body.encode("utf-8")
            self.send_response(code)
            self.send_header("Content-Type", ctype + "; charset=utf-8")
            self.send_header("Content-Length", str(len(data)))
            self.send_header("Cache-Control", "no-store")
            self.send_header("X-Content-Type-Options", "nosniff")
            self.send_header("X-Frame-Options", "DENY")  # no clickjacking via a frame
            self.send_header("Content-Security-Policy", "frame-ancestors 'none'")
            for k, v in headers:
                self.send_header(k, v)
            self.end_headers()
            self.wfile.write(data)

        def host_ok(self):
            # Blocks DNS rebinding: the browser must be talking to us by our own address.
            return self.headers.get("Host") in (f"127.0.0.1:{srv_port}", f"localhost:{srv_port}")

        def origin_ok(self):
            # Browsers send Origin on cross-origin and on POST requests; when present it must be us.
            origin = self.headers.get("Origin")
            return origin is None or origin in (f"http://127.0.0.1:{srv_port}", f"http://localhost:{srv_port}")

        def api_ok(self):
            token = self.headers.get("X-CCSR-Token") or ""
            return (self.host_ok() and self.origin_ok() and self.has_cookie()
                    and same(token, api_token))

        def has_cookie(self):
            for part in (self.headers.get("Cookie") or "").split(";"):
                k, _, v = part.strip().partition("=")
                if k == "ccsr" and same(v, cookie):
                    return True
            return False

        def do_GET(self):
            if not self.host_ok() or not self.origin_ok():
                return self.send(403, '{"error": "bad host or origin"}')
            u = urlparse(self.path)
            q = parse_qs(u.query)
            if u.path == "/":
                t = q.get("t", [""])[0]
                with lock:
                    fresh = bool(t) and not state["url_used"] and same(t, url_token)
                    if fresh:
                        state["url_used"] = True
                if fresh:
                    state["last"] = time.time()
                    return self.send(200, first_page, "text/html", [(
                        "Set-Cookie", f"ccsr={cookie}; Path=/; HttpOnly; SameSite=Strict")])
                if self.has_cookie():
                    state["last"] = time.time()
                    return self.send(200, later_page, "text/html")
                return self.send(403, "This link has already been used. Run cc-session-restore --gui again.",
                                 "text/plain")
            if not self.api_ok():
                return self.send(403, '{"error": "not authorized"}')
            state["last"] = time.time()
            if u.path == "/api/sessions":
                n = q.get("n", [""])[0]
                n = int(n) if n.isdecimal() and len(n) < 6 else count
                return self.send(200, json.dumps(sessions_payload(n)))
            self.send(404, '{"error": "not found"}')

        def do_POST(self):
            if not self.api_ok():
                return self.send(403, '{"error": "not authorized"}')
            # A JSON body can't be sent cross-origin without a CORS preflight, which we never allow.
            ctype = (self.headers.get("Content-Type") or "").split(";")[0].strip().lower()
            if ctype != "application/json":
                return self.send(415, '{"error": "expected application/json"}')
            if urlparse(self.path).path != "/api/open":
                return self.send(404, '{"error": "not found"}')
            state["last"] = time.time()
            with lock:  # one open per picker: a double Enter must not resume twice
                if state["opening"] or state["done"]:
                    return self.send(409, '{"error": "already opening", "opened": 0}')
                state["opening"] = True
            try:
                length = min(int(self.headers.get("Content-Length") or 0), 1 << 20)
                body = json.loads(self.rfile.read(length) or b"{}")
                ids = body.get("ids") if isinstance(body, dict) else None
                ids = [i for i in ids if isinstance(i, str)] if isinstance(ids, list) else []
                by_id = {s["id"]: s for s in recent_sessions() if not s["running"]}
                chosen = [by_id[i] for i in dict.fromkeys(ids) if i in by_id]
                errors = launch(chosen, terminal=terminal, log=lambda *_: None)
                self.send(200, json.dumps({"opened": len(chosen) - len(errors), "errors": errors}))
                state["done"] = True
            except SystemExit as e:  # die() inside launch
                state["opening"] = False
                self.send(200, json.dumps({"error": str(e), "opened": 0}))
            except Exception as e:
                state["opening"] = False
                self.send(500, json.dumps({"error": f"{type(e).__name__}: {e}", "opened": 0}))

    try:
        srv = ThreadingHTTPServer(("127.0.0.1", port), Handler)
    except OSError as e:
        die(f"can't listen on port {port} ({e.strerror}). Pick another with --port, "
            "or leave it out to use any free port.")
    srv_port = srv.server_address[1]
    url = f"http://127.0.0.1:{srv_port}/?t={url_token}"
    print(f"cc-session-restore: {url}", flush=True)
    if browser:
        open_in_browser(url)
    srv.timeout = 0.5
    while not state["done"] and time.time() - state["last"] < idle_timeout:
        srv.handle_request()
    time.sleep(0.2)  # let the last response finish
    srv.server_close()


