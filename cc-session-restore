def sessions_payload(count):
    sessions = limit(recent_sessions(), count)
    checked = precheck(sessions)
    return {"running": sum(s["running"] for s in sessions), "sessions": [
        {"id": s["id"], "title": s["title"], "cwd": s["cwd"], "ago": ago(s["mtime"]),
         "folder": pretty_path(s["cwd"]), "checked": i in checked, "running": s["running"]}
        for i, s in enumerate(sessions)]}


def open_in_browser(url):
    import webbrowser
    if IS_WSL and shutil.which("cmd.exe"):  # use the Windows browser
        subprocess.Popen(["cmd.exe", "/c", "start", "", url], stdout=subprocess.DEVNULL,
                         stderr=subprocess.DEVNULL, cwd="/mnt/c" if Path("/mnt/c").is_dir() else None)
    else:
        webbrowser.open(url)


def run_gui(count, terminal, browser=True, port=0, idle_timeout=900):
    """Serve the picker page on localhost until you open sessions or leave it idle."""
    import secrets
    from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
    from urllib.parse import parse_qs, urlparse

    token = secrets.token_urlsafe(16)  # so other web pages can't drive this server
    state = {"done": False, "last": time.time()}

    class Handler(BaseHTTPRequestHandler):
        def log_message(self, *args):
            pass

        def send(self, code, body, ctype="application/json"):
            data = body.encode("utf-8")
            self.send_response(code)
            self.send_header("Content-Type", ctype + "; charset=utf-8")
            self.send_header("Content-Length", str(len(data)))
            self.send_header("Cache-Control", "no-store")
            self.end_headers()
            self.wfile.write(data)

        def authorized(self):
            state["last"] = time.time()
            q = parse_qs(urlparse(self.path).query)
            if q.get("t", [None])[0] != token:
                self.send(403, '{"error": "bad token"}')
                return None
            return q

        def do_GET(self):
            q = self.authorized()
            if q is None:
                return
            path = urlparse(self.path).path
            if path == "/":
                self.send(200, PAGE, "text/html")
            elif path == "/api/sessions":
                n = q.get("n", [str(count)])[0]
                self.send(200, json.dumps(sessions_payload(int(n) if n.isdigit() else count)))
            else:
                self.send(404, '{"error": "not found"}')

        def do_POST(self):
            if self.authorized() is None:
                return
            if urlparse(self.path).path != "/api/open":
                return self.send(404, '{"error": "not found"}')
            try:
                length = int(self.headers.get("Content-Length") or 0)
                ids = json.loads(self.rfile.read(length) or b"{}").get("ids") or []
                by_id = {s["id"]: s for s in recent_sessions() if not s["running"]}
                chosen = [by_id[i] for i in ids if i in by_id]
                launch(chosen, terminal=terminal, log=lambda *_: None)
                self.send(200, json.dumps({"opened": len(chosen)}))
                state["done"] = True
            except SystemExit as e:  # die() inside launch
                self.send(200, json.dumps({"error": str(e), "opened": 0}))
            except Exception as e:
                self.send(500, json.dumps({"error": f"{type(e).__name__}: {e}", "opened": 0}))

    srv = ThreadingHTTPServer(("127.0.0.1", port), Handler)
    url = f"http://127.0.0.1:{srv.server_address[1]}/?t={token}"
    print(f"cc-session-restore: {url}", flush=True)
    if browser:
        open_in_browser(url)
    srv.timeout = 0.5
    while not state["done"] and time.time() - state["last"] < idle_timeout:
        srv.handle_request()
    srv.server_close()


# ---------------------------------------------------------------- install

def windows_shortcut(powershell, target, arguments, workdir):
    """Create '<Start menu>/Claude Code sessions.lnk' via PowerShell."""
    q = lambda v: "'" + str(v).replace("'", "''") + "'"
    ps = ("$s=(New-Object -ComObject WScript.Shell).CreateShortcut((Join-Path "
          "([Environment]::GetFolderPath('Programs')) 'Claude Code sessions.lnk'));"
          f"$s.TargetPath={q(target)};$s.Arguments={q(arguments)};"
          f"$s.WorkingDirectory={q(workdir)};$s.WindowStyle=7;"
          "$s.Description='Reopen your Claude Code sessions (cc-session-restore)';$s.Save()")
    subprocess.run([powershell, "-NoProfile", "-Command", ps], check=True,
                   cwd="/mnt/c" if IS_WSL and Path("/mnt/c").is_dir() else None)


def install():
    """Add a "Claude Code sessions" launcher that opens the picker page."""
    me = Path(__file__).resolve()
    if IS_WSL:
        # Start menu shortcut -> hidden PowerShell -> hidden wsl.exe -> this script.
        # The command is base64-encoded so paths with spaces/quotes survive.
        import base64
        distro = os.environ["WSL_DISTRO_NAME"]
        wsl_args = f'-d {distro} --cd "{me.parent}" -- python3 "./{me.name}" --gui'
        cmd = f"Start-Process wsl.exe -WindowStyle Hidden -ArgumentList '{wsl_args.replace(chr(39), chr(39) * 2)}'"
        enc = base64.b64encode(cmd.encode("utf-16-le")).decode()
        windows_shortcut("powershell.exe", "powershell.exe",
                         f"-NoProfile -WindowStyle Hidden -EncodedCommand {enc}", "C:\\")
        print("Added Windows Start menu shortcut: Claude Code sessions")
    elif IS_WINDOWS:
        pyw = Path(sys.executable).with_name("pythonw.exe")  # no console window
        windows_shortcut("powershell", pyw if pyw.exists() else sys.executable,
                         f'"{me}" --gui', me.parent)
        print("Added Start menu shortcut: Claude Code sessions")
    elif IS_MAC:
        app = Path.home() / "Applications" / "Claude Code sessions.command"
        app.parent.mkdir(exist_ok=True)
        app.write_text(f"#!/bin/sh\nexec {shlex.quote(sys.executable)} {shlex.quote(str(me))} --gui\n")
        app.chmod(0o755)
        print(f"Added {app}\n(double-click it, or drag it to the Dock)")
    else:
        apps = Path(os.environ.get("XDG_DATA_HOME") or Path.home() / ".local/share") / "applications"
        apps.mkdir(parents=True, exist_ok=True)
        entry = apps / "cc-session-restore.desktop"
        entry.write_text(
            "[Desktop Entry]\nType=Application\nName=Claude Code sessions\n"
            "Comment=Reopen your Claude Code sessions\n"
            f"Exec={shlex.quote(sys.executable)} {shlex.quote(str(me))} --gui\n"
            "Icon=utilities-terminal\nTerminal=false\nCategories=Development;\n")
        print(f"Added app launcher: {entry}")


# ---------------------------------------------------------------- main

def main(argv):
    if "-h" in argv or "--help" in argv:
        print(__doc__)
        return False
    if "--install" in argv:
        install()
        return False

    def opt(flag):
        if flag not in argv:
            return None
        i = argv.index(flag)
        if i + 1 >= len(argv):
            die(f"{flag} needs a value")
        return argv[i + 1]

    count = DEFAULT_COUNT
    if opt("-n") is not None:
        if not opt("-n").isdigit():
            die("-n needs a number")
        count = int(opt("-n"))
    terminal = opt("--terminal")
    dry_run = "--dry-run" in argv

    if "--gui" in argv:
        port = opt("--port")
        run_gui(count, terminal, browser="--no-browser" not in argv,
                port=int(port) if port and port.isdigit() else 0)
        return True

    sessions = recent_sessions()
    if "--open" in argv:
        ids = argv[argv.index("--open") + 1:]
        by_id = {s["id"]: s for s in sessions if not s["running"]}
        launch([by_id[i] for i in ids if i in by_id], dry_run, terminal)
        return True

    sessions = limit(sessions, count)
    if "--json" in argv:
        print(json.dumps(sessions_payload(count)))
        return False

    print("\ncc-session-restore - your most recent Claude Code sessions")
    print("[x] = was open when the machine went down    running = already open\n")
    if not sessions:
        print("No sessions found.")
        return False
    selected = precheck(sessions)
    if "list" in argv:
        show(sessions, selected)
        return False
    chosen = ([sessions[i] for i in sorted(selected)] if ("-y" in argv or "--yes" in argv)
              else pick(sessions, selected))
    if not chosen:
        print("Nothing opened.")
        return False
    launch(chosen, dry_run, terminal)
    return True


if __name__ == "__main__":
    if hasattr(sys.stdout, "reconfigure"):
        sys.stdout.reconfigure(encoding="utf-8", errors="replace")  # titles may have emoji
    opened = main([a for a in sys.argv[1:] if a != "--wait"])
    # Double-clicked from a file manager: keep the window up so you can read it.
    if "--wait" in sys.argv and not opened:
        try:
            input("\nPress Enter to close.")
        except EOFError:
            pass
