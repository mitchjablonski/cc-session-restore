#!/usr/bin/env python3
"""cc-session-restore - reopen your Claude Code sessions after a restart.

Unofficial; not affiliated with Anthropic. Works on macOS, Linux, Windows and WSL.

  cc-session-restore              interactive picker in the terminal
  cc-session-restore --gui        the same, as a page in your browser
                                  (--no-browser just prints the URL; --port N picks the port)
  cc-session-restore list         just print the list
  cc-session-restore -y           reopen the pre-checked sessions without asking
  cc-session-restore -n 30        show 30 sessions instead of 15
  cc-session-restore --dry-run    print the launch commands instead of running them
  cc-session-restore --terminal T open sessions with terminal T (see below)
  cc-session-restore --install    add a "Claude Code sessions" launcher (Start menu / app menu)
  cc-session-restore --json       machine-readable list
  cc-session-restore --open ID... open these sessions by id

Terminals: wsl (Windows Terminal from WSL), windows-terminal, windows-console,
tmux, iterm, macos-terminal, gnome-terminal, konsole, xfce4-terminal, kitty,
wezterm, alacritty, x-terminal-emulator, xterm. Picked automatically; override
with --terminal or CC_SESSION_RESTORE_TERMINAL.

Environment:
  CC_SESSION_RESTORE_TERMINAL     terminal to use (as above)
  CC_SESSION_RESTORE_CLAUDE_ARGS  extra flags for every resumed session, e.g. "--model opus"
  CC_SESSION_RESTORE_CLAUDE_BIN   command to run instead of `claude`
  CLAUDE_CONFIG_DIR               Claude Code's config folder (default ~/.claude)

How it knows what you had open:
  - Every session's transcript (<config>/projects/*/<id>.jsonl) is written on
    every message, so its file time is when you last used that session.
  - Claude Code keeps <config>/sessions/<pid>.json while a session runs. A
    restart kills the process but leaves the file, so a leftover file whose
    process is gone means "this was open when the machine went down".
  - Sessions still running are listed as "running" and can't be opened again.
"""
import json
import os
import re
import shlex
import shutil
import subprocess
import sys
import tempfile
import time
from pathlib import Path

CLAUDE = Path(os.environ.get("CLAUDE_CONFIG_DIR") or Path.home() / ".claude")
PROJECTS = CLAUDE / "projects"
REGISTRY = CLAUDE / "sessions"
DEFAULT_COUNT = 15
SCAN_LIMIT = 400          # newest transcripts to look at
HEAD_BYTES = 256 * 1024   # enough of a transcript to find its cwd/title
PRECHECK_DAYS = 3
CLAUDE_ARGS = os.environ.get("CC_SESSION_RESTORE_CLAUDE_ARGS", "")
CLAUDE_BIN = os.environ.get("CC_SESSION_RESTORE_CLAUDE_BIN", "claude")
WINDOW_NAME = "claude"    # Windows Terminal window that sessions open in

IS_WINDOWS = os.name == "nt"
IS_MAC = sys.platform == "darwin"
IS_WSL = bool(os.environ.get("WSL_DISTRO_NAME"))
TEMP_DIRS = {str(Path(tempfile.gettempdir()).resolve()), "/tmp", "/private/tmp", "/var/folders"}


def die(msg):
    sys.exit(f"cc-session-restore: {msg}")


# ---------------------------------------------------------------- liveness

def _alive_windows(pid):
    import ctypes
    k32 = ctypes.windll.kernel32
    h = k32.OpenProcess(0x1000, False, pid)  # PROCESS_QUERY_LIMITED_INFORMATION
    if not h:
        return False
    code = ctypes.c_ulong()
    ok = k32.GetExitCodeProcess(h, ctypes.byref(code))
    k32.CloseHandle(h)
    return bool(ok) and code.value == 259  # STILL_ACTIVE


def is_alive(d):
    """True if a registry entry's process is still running."""
    pid = d.get("pid")
    if not isinstance(pid, int):
        return False
    if IS_WINDOWS:
        return _alive_windows(pid)
    stat = Path(f"/proc/{pid}/stat")
    if stat.exists() or sys.platform.startswith("linux"):
        # Linux: also compare start times, so a reused pid after reboot doesn't count.
        try:
            fields = stat.read_text().rsplit(")", 1)[1].split()
        except OSError:
            return False
        proc_start = d.get("procStart")
        return proc_start is None or str(proc_start) == fields[19]
    try:
        os.kill(pid, 0)
    except ProcessLookupError:
        return False
    except PermissionError:
        return True
    except OSError:
        return False
    return True


# ---------------------------------------------------------------- discovery

def read_registry():
    """-> (running session ids, ids left behind by a dead process, names by id)"""
    running, dead, names, newest = set(), set(), {}, {}
    for f in REGISTRY.glob("*.json"):
        try:
            d = json.loads(f.read_text(encoding="utf-8"))
        except (OSError, ValueError):
            continue
        sid = d.get("sessionId")
        if not sid:
            continue
        if is_alive(d):
            running.add(sid)
        elif d.get("entrypoint") == "cli" and d.get("kind") == "interactive":
            dead.add(sid)
        upd = d.get("updatedAt") or 0
        if d.get("name") and upd >= newest.get(sid, -1):
            newest[sid], names[sid] = upd, d["name"]
    return running, dead - running, names


def read_head(path):
    """Pull cwd, entrypoint and title from the start of a transcript."""
    info = {}
    try:
        with open(path, "rb") as fh:
            chunk = fh.read(HEAD_BYTES)
    except OSError:
        return info
    for line in chunk.splitlines():
        try:
            d = json.loads(line)
        except ValueError:
            continue  # includes the cut-off last line
        if not isinstance(d, dict):
            continue
        if "cwd" in d and "cwd" not in info:
            info["cwd"] = d["cwd"]
            info["entrypoint"] = d.get("entrypoint")
        if d.get("type") == "custom-title":
            info["title"] = d.get("customTitle")
        elif d.get("type") == "ai-title" and "aiTitle" not in info:
            info["aiTitle"] = d.get("aiTitle")
    return info


def in_temp_dir(cwd):
    return any(cwd == t or cwd.startswith((t + "/", t + os.sep)) for t in TEMP_DIRS)


def recent_sessions():
    running, dead, names = read_registry()
    files = []
    for p in PROJECTS.glob("*/*.jsonl"):
        try:
            files.append((p.stat().st_mtime, p))
        except OSError:
            pass
    files.sort(reverse=True)

    sessions = []
    for mtime, p in files[:SCAN_LIMIT]:
        sid = p.stem
        info = read_head(p)
        cwd = info.get("cwd")
        # Only sessions you ran yourself in a terminal, in folders that still exist.
        if info.get("entrypoint") != "cli" or not cwd or in_temp_dir(cwd):
            continue
        if not Path(cwd).is_dir():
            continue
        title = names.get(sid) or info.get("title") or info.get("aiTitle") or Path(cwd).name
        sessions.append({"id": sid, "cwd": cwd, "title": title, "mtime": mtime,
                         "was_open": sid in dead, "running": sid in running})
    return sessions


def limit(sessions, count):
    """All running sessions, then the `count` most recent ones that aren't running."""
    live = [s for s in sessions if s["running"]]
    rest = [s for s in sessions if not s["running"]][:count]
    return live + rest


def precheck(sessions):
    """Indexes of sessions killed by the latest restart. Older leftovers come from
    earlier crashes, so only count those within a few days of the newest one."""
    dead = [s for s in sessions if s["was_open"] and not s["running"]]
    cutoff = max((s["mtime"] for s in dead), default=0) - PRECHECK_DAYS * 86400
    return {i for i, s in enumerate(sessions)
            if s["was_open"] and not s["running"] and s["mtime"] >= cutoff}


def ago(ts):
    s = time.time() - ts
    for unit, n in (("d", 86400), ("h", 3600), ("m", 60)):
        if s >= n:
            return f"{int(s // n)}{unit} ago"
    return "just now"


def pretty_path(cwd):
    cwd = re.sub(r"^/mnt/c/Users/[^/]+/", "C:~/", cwd)  # WSL view of the Windows profile
    home = str(Path.home())
    if cwd == home or cwd.startswith(home + os.sep):
        cwd = "~" + cwd[len(home):]
    return cwd


# ---------------------------------------------------------------- launching

def detect_terminal():
    t = os.environ.get("CC_SESSION_RESTORE_TERMINAL")
    if t:
        return t
    if IS_WSL and shutil.which("wt.exe"):
        return "wsl"
    if IS_WINDOWS:
        return "windows-terminal" if shutil.which("wt.exe") else "windows-console"
    if os.environ.get("TMUX"):
        return "tmux"
    if IS_MAC:
        if os.environ.get("TERM_PROGRAM") == "iTerm.app":
            return "iterm"
        if os.environ.get("TERM_PROGRAM") == "Apple_Terminal":
            return "macos-terminal"
        return "iterm" if Path("/Applications/iTerm.app").exists() else "macos-terminal"
    # Linux: the terminal we're running in, if we can tell, else the first one installed.
    if os.environ.get("WEZTERM_PANE"):
        return "wezterm"
    if os.environ.get("KITTY_WINDOW_ID"):
        return "kitty"
    if os.environ.get("KONSOLE_VERSION"):
        return "konsole"
    if os.environ.get("GNOME_TERMINAL_SCREEN") or os.environ.get("GNOME_TERMINAL_SERVICE"):
        return "gnome-terminal"
    for t in ("gnome-terminal", "konsole", "xfce4-terminal", "kitty", "wezterm",
              "alacritty", "x-terminal-emulator", "xterm"):
        if shutil.which(t):
            return t
    die("couldn't find a terminal to open sessions in. Set CC_SESSION_RESTORE_TERMINAL.")


def claude_cmd(s):
    return f"{shlex.quote(CLAUDE_BIN)} --resume {s['id']} {CLAUDE_ARGS}".strip()


def applescript_str(text):
    return '"' + text.replace("\\", "\\\\").replace('"', '\\"') + '"'


def launch_cmd(s, terminal):
    """-> (argv, popen kwargs) that open session s in a new tab/window."""
    cwd, title, inner = s["cwd"], s["title"], claude_cmd(s)
    win_cmd = ["cmd", "/k", CLAUDE_BIN, "--resume", s["id"], *shlex.split(CLAUDE_ARGS)]
    # POSIX: run through a login+interactive shell so `claude` is on PATH the
    # same way it is when you open a terminal yourself.
    shell = os.environ.get("SHELL") or "/bin/bash"
    sh = [shell, "-lic", inner]

    if terminal == "wsl":
        distro = os.environ.get("WSL_DISTRO_NAME") or die("--terminal wsl only works inside WSL")
        return ["wt.exe", "-w", WINDOW_NAME, "new-tab", "--title", title, "wsl.exe",
                "-d", distro, "--cd", cwd, "--", "bash", "-lic", inner], {}
    if terminal == "windows-terminal":
        return ["wt.exe", "-w", WINDOW_NAME, "new-tab", "--title", title, "-d", cwd,
                *win_cmd], {}
    if terminal == "windows-console":
        return win_cmd, {"cwd": cwd, "creationflags": 0x10}  # CREATE_NEW_CONSOLE
    if terminal == "tmux":
        return ["tmux", "new-window", "-n", title, "-c", cwd, shlex.join(sh)], {}
    if terminal == "macos-terminal":
        script = (f'tell application "Terminal"\nactivate\n'
                  f'do script {applescript_str("cd " + shlex.quote(cwd) + " && " + inner)}\nend tell')
        return ["osascript", "-e", script], {}
    if terminal == "iterm":
        script = (
            'tell application "iTerm2"\nactivate\n'
            'if (count of windows) = 0 then\ncreate window with default profile\n'
            'else\ntell current window to create tab with default profile\nend if\n'
            f'tell current session of current window to write text '
            f'{applescript_str("cd " + shlex.quote(cwd) + " && " + inner)}\nend tell')
        return ["osascript", "-e", script], {}
    linux = {
        "gnome-terminal": ["gnome-terminal", "--tab", "--title", title, "--working-directory", cwd, "--", *sh],
        "konsole": ["konsole", "--new-tab", "--workdir", cwd, "-e", *sh],
        "xfce4-terminal": ["xfce4-terminal", "--tab", "--title", title, "--working-directory", cwd, "-x", *sh],
        "kitty": ["kitty", "--directory", cwd, "--title", title, *sh],
        "wezterm": (["wezterm", "cli", "spawn", "--cwd", cwd, "--", *sh] if os.environ.get("WEZTERM_PANE")
                    else ["wezterm", "start", "--cwd", cwd, "--", *sh]),
        "alacritty": ["alacritty", "--working-directory", cwd, "--title", title, "-e", *sh],
        "x-terminal-emulator": ["x-terminal-emulator", "-e", *sh],
        "xterm": ["xterm", "-T", title, "-e", *sh],
    }
    if terminal in linux:
        return linux[terminal], {"cwd": cwd}
    die(f"unknown terminal '{terminal}'. Run with --help to see the options.")


def launch(sessions, dry_run=False, terminal=None, log=print):
    terminal = terminal or detect_terminal()
    for s in sessions:
        argv, kw = launch_cmd(s, terminal)
        if dry_run:
            log(" ".join(shlex.quote(c) for c in argv))
            continue
        if not shutil.which(argv[0]):
            die(f"'{argv[0]}' not found (terminal: {terminal}). Set CC_SESSION_RESTORE_TERMINAL.")
        log(f"  opening {s['title']}")
        subprocess.Popen(argv, stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                         stderr=subprocess.DEVNULL, **kw)
        # Windows Terminal drops tabs that arrive too fast; others just keep order.
        time.sleep(0.8 if terminal in ("wsl", "windows-terminal") else 0.3)


# ---------------------------------------------------------------- text UI

def show(sessions, selected):
    for i, s in enumerate(sessions, 1):
        mark = "running" if s["running"] else ("[x]" if i - 1 in selected else "[ ]")
        print(f"  {mark:>7} {i:2}  {s['title'][:28]:<28}  {ago(s['mtime']):>9}  {pretty_path(s['cwd'])}")


def pick(sessions, selected):
    while True:
        show(sessions, selected)
        try:
            ans = input("\nEnter = open checked | numbers (e.g. 2 5) = toggle | a = all | n = none | q = quit: ").strip().lower()
        except EOFError:
            return []
        print()
        if ans == "":
            return [sessions[i] for i in sorted(selected)]
        if ans == "q":
            return []
        if ans == "a":
            selected = {i for i, s in enumerate(sessions) if not s["running"]}
        elif ans == "n":
            selected = set()
        else:
            for tok in ans.replace(",", " ").split():
                if tok.isdigit() and 1 <= int(tok) <= len(sessions) and not sessions[int(tok) - 1]["running"]:
                    selected ^= {int(tok) - 1}


