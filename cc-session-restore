def windows_shortcut(powershell, target, arguments, workdir):
    """Create '<Start menu>/Claude Code sessions.lnk' via PowerShell."""
    q = lambda v: "'" + str(v).replace("'", "''") + "'"
    ps = ("$s=(New-Object -ComObject WScript.Shell).CreateShortcut((Join-Path "
          "([Environment]::GetFolderPath('Programs')) 'Claude Code sessions.lnk'));"
          f"$s.TargetPath={q(target)};$s.Arguments={q(arguments)};"
          f"$s.WorkingDirectory={q(workdir)};$s.WindowStyle=7;"
          "$s.Description='Reopen your Claude Code sessions (cc-session-restore)';$s.Save()")
    subprocess.run([powershell, "-NoProfile", "-Command", ps], check=True,
                   cwd="/mnt/c" if IS_WSL and Path("/mnt/c").is_dir() else None)


def desktop_quote(arg):
    """Quote an argument for a .desktop Exec line (Desktop Entry spec)."""
    for ch in ("\\", '"', "`", "$"):
        arg = arg.replace(ch, "\\" + ch)
    # Exec is also a string value, whose own escapes are undone first: double every backslash.
    return '"' + arg.replace("%", "%%").replace("\\", "\\\\") + '"'


def ephemeral_install(me):
    """True if `me` runs from a throwaway pipx/uv environment (`uvx`, `pipx run`)."""
    parts = [p.lower() for p in me.parts]
    pairs = set(zip(parts, parts[1:]))
    if any(re.fullmatch(r"(archive|builds)-v\d+", p) for p in parts):
        return True  # uv cache (uvx): <cache>/archive-v0/<hash>/bin/...
    venv = (me.parent.parent / "pyvenv.cfg").is_file()  # bin/<script> in a venv
    if ("pipx", ".cache") in pairs or (".cache", "pipx") in pairs or (
            venv and me.parent.parent.parent.name == ".cache"):
        return True  # pipx run: <PIPX_HOME>/.cache/<hash> or ~/.cache/pipx/<hash>
    # A tool venv inside the temp dir, but not a plain git clone there.
    return venv and in_temp_dir(str(me))


def install():
    """Add a "Claude Code sessions" launcher that opens the picker page."""
    # The launcher runs this file with this interpreter. Under pipx or
    # `uv tool install` these are the tool venv's bin/cc-session-restore (the
    # PATH entry is a symlink to it, which resolve() follows) and its python;
    # both last until the tool is uninstalled. `pipx run` and `uvx` run from a
    # cache that gets cleaned up, so a launcher made from there would break.
    me = Path(__file__).resolve()
    if ephemeral_install(me):
        die(f"this copy runs from a temporary pipx/uv environment ({me.parent}) that will be "
            "cleaned up, so a launcher would stop working. Install it with "
            "`pipx install` or `uv tool install`, then run --install again.")
    python = sys.executable or "python3"
    if IS_WSL:
        # Start menu shortcut -> hidden PowerShell -> hidden wsl.exe -> this script.
        # The PowerShell command is base64-encoded so the shortcut needs no quoting.
        import base64
        if '"' in str(me) + python:
            die("the script or Python path contains a double quote, which wsl.exe can't take: "
                f"{me} / {python}. Move it to a folder without one.")
        distro = os.environ["WSL_DISTRO_NAME"]
        wsl_args = f'-d {distro} --cd "{me.parent}" -- "{python}" "./{me.name}" --gui'
        cmd = f"Start-Process wsl.exe -WindowStyle Hidden -ArgumentList '{wsl_args.replace(chr(39), chr(39) * 2)}'"
        enc = base64.b64encode(cmd.encode("utf-16-le")).decode()
        windows_shortcut("powershell.exe", "powershell.exe",
                         f"-NoProfile -WindowStyle Hidden -EncodedCommand {enc}", "C:\\")
        print("Added Windows Start menu shortcut: Claude Code sessions")
    elif IS_WINDOWS:
        pyw = Path(sys.executable).with_name("pythonw.exe")  # no console window
        windows_shortcut("powershell", pyw if pyw.exists() else sys.executable,
                         f'"{me}" --gui', me.parent)
        print("Added Start menu shortcut: Claude Code sessions")
    elif IS_MAC:
        app = Path.home() / "Applications" / "Claude Code sessions.command"
        app.parent.mkdir(exist_ok=True)
        app.write_text(f"#!/bin/sh\nexec {shlex.quote(sys.executable)} {shlex.quote(str(me))} --gui\n")
        app.chmod(0o755)
        print(f"Added {app}\n(double-click it, or drag it to the Dock)")
    else:
        for path in (sys.executable, str(me)):
            try:
                path.encode("utf-8")
            except UnicodeEncodeError:
                die(f"{path!r} isn't valid UTF-8, which a .desktop file needs. Move it.")
            if "\n" in path or "\r" in path:
                die(f"{path!r} contains a line break, which a .desktop file can't hold. Move it.")
        apps = Path(os.environ.get("XDG_DATA_HOME") or Path.home() / ".local/share") / "applications"
        apps.mkdir(parents=True, exist_ok=True)
        entry = apps / "cc-session-restore.desktop"
        entry.write_text(
            "[Desktop Entry]\nType=Application\nName=Claude Code sessions\n"
            "Comment=Reopen your Claude Code sessions\n"
            f"Exec={desktop_quote(sys.executable)} {desktop_quote(str(me))} --gui\n"
            "Icon=utilities-terminal\nTerminal=false\nCategories=Development;\n", encoding="utf-8")
        print(f"Added app launcher: {entry}")


# ---------------------------------------------------------------- main

FAILED = []


def is_doctor_command(argv):
    args = iter(argv)
    for arg in args:
        if arg == "--open":  # All remaining arguments are session IDs (including "doctor").
            return False
        if arg in ("-n", "--port", "--terminal"):
            next(args, None)
        elif not arg.startswith("-"):
            return arg == "doctor"
    return False


def main(argv):
    if "-h" in argv or "--help" in argv:
        print(__doc__)
        return False
    if is_doctor_command(argv):
        doctor(verbose="--verbose" in argv)
        return False
    if "--install" in argv:
        install()
        return False

    def opt(flag):
        if flag not in argv:
            return None
        i = argv.index(flag)
        if i + 1 >= len(argv):
            die(f"{flag} needs a value")
        return argv[i + 1]

    count = DEFAULT_COUNT
    if opt("-n") is not None:
        if not opt("-n").isdecimal():
            die("-n needs a number")
        count = int(opt("-n"))
    terminal = opt("--terminal")
    dry_run = "--dry-run" in argv

    if "--gui" in argv:
        port = opt("--port")
        if port is not None and not (port.isdecimal() and int(port) < 65536):
            die("--port needs a number below 65536")
        run_gui(count, terminal, browser="--no-browser" not in argv, port=int(port or 0))
        return True

    def report(errors):
        for e in errors:
            print(f"  failed: {e}", file=sys.stderr, flush=True)
        if errors:
            FAILED.append(True)
        return not errors

    if "--open" in argv:
        ids = argv[argv.index("--open") + 1:]
        by_id = {s["id"]: s for s in recent_sessions() if not s["running"]}
        return report(launch([by_id[i] for i in dict.fromkeys(ids) if i in by_id], dry_run, terminal))

    if "--json" in argv:
        print(json.dumps(sessions_payload(count)))
        return False

    all_sessions = recent_sessions()
    selected = precheck(all_sessions)
    sessions = limit(all_sessions, count, selected)
    print("\ncc-session-restore - your most recent Claude Code sessions")
    print("[x] = was open when the machine went down    running = already open\n")
    if not sessions:
        print("No sessions found.")
        return False
    if "list" in argv:
        show(sessions, selected)
        return False
    if "-y" in argv or "--yes" in argv:
        chosen = [s for s in all_sessions if s["id"] in selected]
    else:
        chosen = pick(sessions, selected)
    if not chosen:
        print("Nothing opened.")
        return False
    return report(launch(chosen, dry_run, terminal))


if __name__ == "__main__":
    if sys.stdout is not None and hasattr(sys.stdout, "reconfigure"):
        sys.stdout.reconfigure(encoding="utf-8", errors="replace")  # titles may have emoji
    opened = main([a for a in sys.argv[1:] if a != "--wait"])
    # Double-clicked from a file manager: keep the window up so you can read it.
    if "--wait" in sys.argv and not opened:
        try:
            input("\nPress Enter to close.")
        except EOFError:
            pass
    sys.exit(1 if FAILED else 0)
